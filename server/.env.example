# 复制本文件为 server/.env 后填写（server/.env 已被 .gitignore 忽略，不会提交）
#
#   cp server/.env.example server/.env

# ============================================
# 必填项
# ============================================

# JWT签名密钥。未配置或长度不足32位时服务会拒绝启动。
# 该值泄露等同于鉴权失效——任何人都能自行签发管理员token，务必保密，
# 且每个环境用各自独立的值，不要复用。
# 生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ============================================
# 以下均为可选项，留空/注释掉则使用 config.py 中的默认值
# ============================================

# MySQL数据库
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=123456
# MYSQL_DATABASE=db_enterprise_qa

# Ollama模型服务
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen3.5:9b
# OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ChromaDB向量库持久化路径（默认为 server/chroma_data）
# CHROMA_PERSIST_DIR=

# 索引分片：每个知识库按 doc_id 哈希拆成 N 个 collection
# 改动只影响新写入落在哪个分片，读取始终遍历全部分片，因此调大调小都是读安全的
# SHARD_COUNT=3
# 是否兼容改造前的单 collection（kb_{id}），存量向量未迁移完不要关闭
# SHARD_READ_LEGACY=true

# 向量化后台任务线程池
# VECTOR_WORKERS=1
# VECTOR_QUEUE_SIZE=100

# ============================================
# 检索质量：混合检索 / 多路召回 / 重排序
# 链路：查询改写 -> 多路召回(向量×N + BM25×1) -> RRF融合 -> 重排 -> 取 RETRIEVER_TOP_K
# 最终返回条数不变，因此提示词长度与生成阶段开销不变。
# 重排与改写各是一次额外的 LLM 调用，是本次新增的主要延迟；现场卡顿时按需关闭：
#   HYBRID_ENABLED=false          退回改造前的纯向量检索
#   RERANK_ENABLED=false          只做混合检索+RRF，不重排
#   QUERY_REWRITE_ENABLED=false   不做查询改写
# ============================================

# 混合检索总开关
# HYBRID_ENABLED=true
# 每一路召回的候选条数（需明显大于 RETRIEVER_TOP_K）
# RECALL_TOP_K=20
# RRF平滑常数。列表只有20条时 k=60 的区分度很平，融合近似"被几路命中"的投票；
# 想更看重单路名次可调到 20 左右
# RRF_K=60
# BM25 中文切分：char(单字+相邻双字，默认) | jieba(装了才生效，用于对比)
# BM25_TOKENIZER=char

# 查询改写。阈值定在8是因为中文问题信息密度高：「员工每年有多少天带薪年假」正好
# 12个字却已是个完整无歧义的问题，改写它纯属白花1~3秒。这是最值得按实际语料微调的参数
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_COUNT=2
# QUERY_REWRITE_MAX_CHARS=8

# 重排序
# RERANK_ENABLED=true
# RERANK_BACKEND=llm             llm | cross_encoder | none
# RERANK_MODEL=                 留空复用 OLLAMA_LLM_MODEL（同模型不触发重新加载）
# RERANK_TOP_N=12               送入重排的候选数；×RERANK_CANDIDATE_CHARS 需落在 LLM_NUM_CTX 内
# RERANK_CANDIDATE_CHARS=300    每个候选在重排提示词里的截断长度
# 重排/改写这类请求路径上的辅助调用超时（秒）。不要沿用生成答案的 LLM_TIMEOUT
# RETRIEVAL_LLM_TIMEOUT=60

# cross_encoder 后端需要：pip install sentence-transformers（会一并安装 torch）。

# LLM答案缓存（L1进程内LRU + L2 MySQL持久层）
# CACHE_ENABLED=true
# CACHE_L1_MAXSIZE=500
# CACHE_L1_TTL=120
# CACHE_L2_TTL=3600

# LLM生成参数。LLM_THINK 三态：true/false 显式开关，auto 表示不发送该参数
# 注意：若改为 true，LLM_NUM_PREDICT 必须同步调大，否则正文会被思考挤成空
# LLM_THINK=false
# LLM_NUM_CTX=8192
# LLM_NUM_PREDICT=2048
# 生成答案的请求超时（秒）。本地模型生成慢所以取很长，但不要设成无限：
# Ollama 卡死时请求会一直挂住，只能重启服务恢复
# LLM_TIMEOUT=3600
