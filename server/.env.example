# 复制本文件为 server/.env 后填写（server/.env 已被 .gitignore 忽略，不会提交）
#
#   cp server/.env.example server/.env

# ============================================
# 必填项
# ============================================

# JWT签名密钥。未配置或长度不足32位时服务会拒绝启动。
# 该值泄露等同于鉴权失效——任何人都能自行签发管理员token，务必保密，
# 且每个环境用各自独立的值，不要复用。
# 生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ============================================
# 以下均为可选项，留空/注释掉则使用 config.py 中的默认值
# ============================================

# MySQL数据库
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=123456
# MYSQL_DATABASE=db_enterprise_qa

# Ollama模型服务
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen3.5:9b
# OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ChromaDB向量库持久化路径（默认为 server/chroma_data）
# CHROMA_PERSIST_DIR=

# 索引分片：每个知识库按 doc_id 哈希拆成 N 个 collection
# 改动只影响新写入落在哪个分片，读取始终遍历全部分片，因此调大调小都是读安全的
# SHARD_COUNT=3
# 是否兼容改造前的单 collection（kb_{id}），存量向量未迁移完不要关闭
# SHARD_READ_LEGACY=true

# 向量化后台任务线程池
# VECTOR_WORKERS=1
# VECTOR_QUEUE_SIZE=100

# LLM答案缓存（L1进程内LRU + L2 MySQL持久层）
# CACHE_ENABLED=true
# CACHE_L1_MAXSIZE=500
# CACHE_L1_TTL=120
# CACHE_L2_TTL=3600

# LLM生成参数。LLM_THINK 三态：true/false 显式开关，auto 表示不发送该参数
# 注意：若改为 true，LLM_NUM_PREDICT 必须同步调大，否则正文会被思考挤成空
# LLM_THINK=false
# LLM_NUM_CTX=8192
# LLM_NUM_PREDICT=2048
